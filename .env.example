# Server-side only. Set these in Netlify with the Functions scope.
# Explicitly enable paid generation after completing Identity setup.
KUECHE90_ENABLE_AI=false
# Comma-separated, verified email addresses allowed to generate images.
KUECHE90_ALLOWED_EMAILS=
# AI Gateway normally injects both variables. For your own Google key,
# set BOTH explicitly (never use a VITE_ prefix for secrets).
# GEMINI_API_KEY=
# GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
